{
 "countertop": "tile",
 "format": 1,
 "id": "go-outside",
 "name": "Go outside?",
 "description": "A one-line answer to whether now is a good time for a walk, a run, the dog, the kids or the laundry line, from your weather and air quality. Shows when the next good window starts.",
 "size": [
  14,
  8,
  8,
  6
 ],
 "uses": [
  "feed"
 ],
 "feeds": [
  "wx",
  "aqi"
 ],
 "hosts": [],
 "taps": false,
 "every": 600,
 "settings": {
  "activity": {
   "type": "choice",
   "label": "For",
   "choices": [
    "Walk",
    "Run",
    "Dog walk",
    "Kids outside",
    "Laundry on the line"
   ],
   "default": "Walk"
  },
  "rain": {
   "type": "int",
   "label": "Too much chance of rain above (%)",
   "default": 30,
   "min": 0,
   "max": 100
  },
  "air": {
   "type": "int",
   "label": "Air quality too poor above (US AQI)",
   "default": 100,
   "min": 25,
   "max": 300
  }
 },
 "code": "Tile(\"go-outside\", {\n  cls: \"go\",\n  css: \".go{display:flex;flex-direction:column;justify-content:center;gap:.35em;container-type:size}\" +\n    \".go .v{font-size:clamp(20px,17cqmin,60px);font-weight:600;line-height:1.1;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}\" +\n    \".go.yes .v{color:var(--accent)}\" +\n    \".go .s{font-size:clamp(14px,8cqmin,26px);color:var(--dim);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\" +\n    \".go .bars{display:flex;gap:3px;height:clamp(12px,12cqmin,36px);margin-top:.3em}\" +\n    \".go .bars i{flex:1;border-radius:3px;background:var(--line);opacity:.5}\" +\n    \".go .bars i.ok{background:var(--accent);opacity:1}\",\n  render(el){\n    const t = (s, v) => this.t(s, v), esc = s => this.esc(s);\n    const j = this.feed(\"weather\"), air = this.feed(\"air\");\n    if (!j || !j.hourly || !j.hourly.time){ el.innerHTML = '<div class=\"v\">' + esc(t(\"Waiting for the weather…\")) + '</div>'; return; }\n    const A = {\n      \"Walk\": {lo: 3, hi: 29, icon: \"🚶\", what: \"a walk\"},\n      \"Run\": {lo: -3, hi: 22, icon: \"🏃\", what: \"a run\"},\n      \"Dog walk\": {lo: -5, hi: 30, icon: \"🐕\", what: \"a dog walk\"},\n      \"Kids outside\": {lo: 8, hi: 32, icon: \"🛝\", what: \"the kids to play out\"},\n      \"Laundry on the line\": {lo: 6, hi: 45, icon: \"👕\", what: \"hanging laundry\", dry: true}\n    }[this.s.activity] || {lo: 3, hi: 29, icon: \"🚶\", what: \"a walk\"};\n    const H = j.hourly, u = (j.current_units || {}).temperature_2m || \"°F\", fahr = !/C/.test(u);\n    const C = x => fahr ? (x - 32) * 5 / 9 : x;\n    const rainMax = Math.min(+this.s.rain || 30, A.dry ? 20 : 100), airMax = +this.s.air || 100;\n    const now = Date.now();\n    let i0 = H.time.findIndex(x => new Date(x).getTime() > now - 3540000);\n    if (i0 < 0) i0 = 0;\n    const N = Math.min(24, H.time.length - i0);\n    const hr = x => new Date(x).toLocaleTimeString([], {hour: \"numeric\"});\n    const why = k => {                      // why hour k isn't good, or \"\" when it is\n      const i = i0 + k, c = H.weather_code[i], p = H.precipitation_probability[i] || 0, tc = C(H.temperature_2m[i]);\n      if (H.is_day && H.is_day[i] === 0) return t(\"It's dark out\");\n      if (c >= 95) return t(\"Thunderstorms\");\n      if (c >= 71 && c <= 77 || c === 85 || c === 86) return t(\"Snow\");\n      if (c >= 51) return t(\"Rain\");\n      if (p > rainMax) return t(\"{p}% chance of rain\", {p});\n      if (!A.dry && air != null && k < 6 && air > airMax) return t(\"Air quality is {n}\", {n: Math.round(air)});\n      if (tc < A.lo) return t(\"Too cold ({n}°)\", {n: Math.round(H.temperature_2m[i])});\n      if (tc > A.hi) return t(\"Too hot ({n}°)\", {n: Math.round(H.temperature_2m[i])});\n      return \"\";\n    };\n    const bad = []; for (let k = 0; k < N; k++) bad.push(why(k));\n    let head, sub, yes = false;\n    if (!bad[0]){\n      let e = 0; while (e < N && !bad[e]) e++;\n      yes = true; head = t(\"Go now\");\n      sub = t(\"Good for {what}\", {what: t(A.what)}) + (e < N ? \" \" + t(\"until {time}\", {time: hr(H.time[i0 + e])}) : \"\");\n    } else {\n      const k = bad.findIndex(x => !x);\n      if (k > 0){ head = t(\"Wait until {time}\", {time: hr(H.time[i0 + k])}); sub = bad[0]; }\n      else { head = t(\"Better to stay in\"); sub = bad.find(x => x && x !== t(\"It's dark out\")) || bad[0]; }\n    }\n    const H0 = i0, tempNow = Math.round(H.temperature_2m[H0]) + \"°\", pNow = (H.precipitation_probability[H0] || 0) + \"%\";\n    const h = el.clientHeight, w = el.clientWidth;\n    const info = tempNow + \" · \" + t(\"{p} rain\", {p: pNow}) + (air != null ? \" · \" + t(\"Air {n}\", {n: Math.round(air)}) : \"\");\n    let out = '<div class=\"v\">' + A.icon + \" \" + esc(head) + '</div><div class=\"s\">' + esc(sub) + '</div>';\n    if (h >= 150) out += '<div class=\"s\">' + esc(info) + '</div>';\n    if (h >= 190 && w >= 260) out += '<div class=\"bars\">' + bad.slice(0, 12).map(x => '<i class=\"' + (x ? \"\" : \"ok\") + '\"></i>').join(\"\") + '</div>';\n    el.className = (el.className || \"\").replace(/\\byes\\b/g, \"\").trim() + (yes ? \" yes\" : \"\");\n    el.innerHTML = out;\n  }\n});\n",
 "gallery": {
  "author": "kizit",
  "version": 1,
  "updated": "2026-11-24"
 }
}
