{
 "countertop": "tile",
 "format": 1,
 "id": "aurora-watch",
 "name": "Aurora watch",
 "description": "Is the aurora out tonight? Shows the Kp index from NOAA's Space Weather Prediction Center, the forecast for the next day, and whether it could reach your latitude.",
 "size": [
  14,
  8,
  8,
  6
 ],
 "uses": [
  "fetch"
 ],
 "feeds": [],
 "hosts": [
  "services.swpc.noaa.gov"
 ],
 "taps": false,
 "every": 600,
 "settings": {
  "lat": {
   "type": "number",
   "label": "Your latitude",
   "help": "Only used to guess how strong a storm has to be to show from where you are. North or south, like 44.9 or -37.8",
   "default": 45,
   "min": -90,
   "max": 90
  }
 },
 "code": "Tile(\"aurora-watch\", {\n  cls: \"au\",\n  css: \".au{display:flex;flex-direction:column;justify-content:center;gap:.35em;container-type:size}\" +\n    \".au .v{font-size:clamp(20px,16cqmin,56px);font-weight:600;line-height:1.1;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}\" +\n    \".au.yes .v{color:var(--accent)}\" +\n    \".au .s{font-size:clamp(14px,8cqmin,26px);color:var(--dim);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\" +\n    \".au .bars{display:flex;align-items:flex-end;gap:3px;height:clamp(24px,20cqmin,70px);margin-top:.3em}\" +\n    \".au .bars i{flex:1;border-radius:3px;background:var(--line);opacity:.6}\" +\n    \".au .bars i.ok{background:var(--accent);opacity:1}\",\n  render(el){\n    const t = (s, v) => this.t(s, v), esc = s => this.esc(s);\n    const U1 = \"https://services.swpc.noaa.gov/products/noaa-planetary-k-index.json\";\n    const U2 = \"https://services.swpc.noaa.gov/products/noaa-planetary-k-index-forecast.json\";\n    const rows = a => {                      // NOAA sends a list of objects, or a table with a header row\n      if (!Array.isArray(a) || !a.length) return [];\n      if (!Array.isArray(a[0])) return a;\n      const hd = a[0].map(x => String(x).toLowerCase());\n      return a.slice(1).map(r => { const o = {}; hd.forEach((k, i) => o[k] = r[i]); return o; });\n    };\n    const at = r => new Date(String(r.time_tag).replace(\" \", \"T\") + (/Z|[+-]\\d\\d:?\\d\\d$/.test(r.time_tag) ? \"\" : \"Z\")).getTime();\n    const kp = r => parseFloat(r.kp != null ? r.kp : r.Kp);\n    const obs = this.fetch(U1, 600), fc = this.fetch(U2, 1800);\n    const O = rows(obs).filter(r => isFinite(kp(r))), F = rows(fc).filter(r => isFinite(kp(r)));\n    if (!O.length && !F.length){\n      el.innerHTML = '<div class=\"v\">' + esc(this.fetchError(U1) || this.fetchError(U2) ? t(\"Couldn't reach NOAA\") : t(\"Loading…\")) + '</div>';\n      return;\n    }\n    const lat = Math.abs(+this.s.lat || 0), need = Math.min(10, Math.max(1, Math.ceil((62.5 - lat) / 2)));\n    const now = Date.now(), cur = O.length ? kp(O[O.length - 1]) : null;\n    const next = F.filter(r => at(r) >= now - 1.5 * 3600e3 && at(r) <= now + 24 * 3600e3);\n    let peak = null; next.forEach(r => { if (!peak || kp(r) > kp(peak)) peak = r; });\n    const scale = k => k >= 9 ? t(\"Extreme storm\") : k >= 8 ? t(\"Severe storm\") : k >= 7 ? t(\"Strong storm\") : k >= 6 ? t(\"Moderate storm\") : k >= 5 ? t(\"Minor storm\") : k >= 4 ? t(\"Active\") : k >= 3 ? t(\"Unsettled\") : t(\"Quiet\");\n    let head, yes = false;\n    if (need > 9) head = cur != null && cur >= 8 ? t(\"A big storm, look north\") : t(\"Out of reach from here\");\n    else if (cur != null && cur >= need){ head = t(\"Aurora possible now\"); yes = true; }\n    else if (peak && kp(peak) >= need){ head = t(\"Aurora possible around {time}\", {time: new Date(at(peak)).toLocaleTimeString([], {hour: \"numeric\"})}); yes = true; }\n    else head = t(\"Quiet skies tonight\");\n    const fmt = k => (Math.round(k * 10) / 10).toString();\n    const s1 = cur != null ? t(\"Kp {k} now · {what}\", {k: fmt(cur), what: scale(cur)}) : t(\"Kp {k} expected\", {k: fmt(kp(peak || F[0]))});\n    const s2 = need <= 9 ? t(\"Needs about Kp {n} here\", {n: need}) : t(\"Needs a Kp above 9 here\");\n    const h = el.clientHeight, w = el.clientWidth;\n    let out = '<div class=\"v\">🌌 ' + esc(head) + '</div><div class=\"s\">' + esc(s1) + '</div>';\n    if (h >= 150) out += '<div class=\"s\">' + esc(s2) + '</div>';\n    if (h >= 190 && w >= 260 && next.length) out += '<div class=\"bars\">' + next.slice(0, 9).map(r => '<i class=\"' + (kp(r) >= need ? \"ok\" : \"\") + '\" style=\"height:' + Math.max(10, Math.round(kp(r) / 9 * 100)) + '%\"></i>').join(\"\") + '</div>';\n    el.className = (el.className || \"\").replace(/\\byes\\b/g, \"\").trim() + (yes ? \" yes\" : \"\");\n    el.innerHTML = out;\n  }\n});\n",
 "gallery": {
  "author": "kizit",
  "version": 1,
  "updated": "2026-11-24"
 }
}
